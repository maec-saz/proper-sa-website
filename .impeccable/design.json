  "narrative": {
    "northStar": "Charcoal & Brushed Metal",
    "overview": "A dark, architectural corporate system: deep charcoal grounds, warm off-white type and a single brushed-metal accent. Large light-weight sans display type carries authority; one phrase per heading turns into an Instrument Serif italic as the human accent. The interface stays square, quiet and hairline-ruled so the imagery and the work lead.",
    "keyCharacteristics": [
      "Dark-first, with stone (light) sections as deliberate pauses.",
      "One accent material, brushed metal.",
      "Square corners; hairline borders instead of shadows.",
      "Light display weights with tight negative tracking; uppercase tracked labels.",
      "Fully mirrored right-to-left for Arabic."
    ],
    "rules": [
      { "name": "The Two-Ground Rule", "section": "colors", "body": "Text colours are paired with their ground family: Warm White, Silver, Mist and Dim Grey on dark grounds; Ink and Slate on Stone. Mist Grey, Dim Grey and Brushed Metal never set text on Stone." },
      { "name": "The 4.5 Floor", "section": "colors", "body": "Every text tier, including the quietest, clears 4.5:1 on the lightest surface it is allowed on." },
      { "name": "The One Small Size Rule", "section": "typography", "body": "Interface text below body is either Small (14px) or Label (12px). No 13, 13.5, 14.5, 15 or half-pixel sizes." },
      { "name": "The Light Display Rule", "section": "typography", "body": "Display XL, Display and Headline are always weight 300 with negative tracking; never bold." },
      { "name": "The Four-Pixel Rule", "section": "layout", "body": "No spacing value outside the 4px scale. Optical nudges (1px hairline offsets, a 2px focus inset) are the only exceptions." },
      { "name": "The Flat-By-Default Rule", "section": "elevation", "body": "Cards and sections never carry drop shadows; separation is a hairline or a tone step." }
    ],
    "dos": [
      "Do pair every text colour with its ground family (The Two-Ground Rule) and keep every text tier at 4.5:1 or above.",
      "Do take every spacing value from the 4px scale (4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 120, 160).",
      "Do keep interface text to Small (14px) and Label (12px) below body, and display headings at weight 300.",
      "Do put exactly one Accent Serif phrase in a display heading, at the end of the line.",
      "Do keep corners square on buttons, chips, inputs, cards and dialogs.",
      "Do mirror layout, arrows and gradients in Arabic, and drop letter-spacing and uppercase there."
    ],
    "donts": [
      "Don't set Mist Grey, Dim Grey or Brushed Metal text on Stone or white.",
      "Don't introduce half-pixel or in-between type sizes (13, 13.5, 14.5, 15, 15.5, 18px).",
      "Don't add drop shadows to cards or sections; use a hairline or a tone step.",
      "Don't use a second accent colour; Brushed Metal is the only one.",
      "Don't add rounded corners to interface controls."
    ]
  }
